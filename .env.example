# Every environment variable the app reads, with its default. scripts/v14test.ts fails if the code
# reads one that isn't listed here. Set them in Vercel → Project → Settings → Environment Variables
# (redeploy after a change). Commented lines are optional and show the default.

# ---- AI providers (each job has its own model order: src/lib/llm/models.ts) ----
# Groq: free tier, per-model daily limits. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b            # shared sections and the admin's briefings
# GROQ_SMALL_MODEL=openai/gpt-oss-20b       # users' briefings beyond the 120b reserve, Ask AI
# GROQ_TRANSLATE_MODEL=qwen/qwen3.8-27b     # translations only
# GROQ_REASONING=low                        # low | medium | high (more = better analysis, more tokens)
# GROQ_TPD=200000                           # tokens per day per Groq model
# GROQ_TPM=8000                             # tokens per minute (prompts are trimmed to fit)
# PRETRANSLATE_DAILY_TOKENS=50000           # tokens a day for translating My Interests briefings ahead of readers (25% of qwen's 200K); beyond it they translate on first read

# Google Gemini: free tier (Flash-Lite: 500 requests/day each). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_RPD=500                            # requests per day per Gemini model

# Claude: pay as you go; goes first in every job when set. https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium                      # low | medium | high

# LLM_PROVIDER=                             # force one provider first: claude | groq | gemini | rules
# LLM_MAX_TOKENS=                           # output cap (default 3000 on Groq, 8192 elsewhere)

# ---- Optional: ticker-tagged company news + earnings dates (free tier) https://finnhub.io ----
FINNHUB_API_KEY=

# ---- Email alerts (optional). Set ONE of these. ----
# Resend: free tier, sends to your own address from onboarding@resend.dev without a domain. https://resend.com
RESEND_API_KEY=
# Or Gmail/any SMTP (app password): smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
# EMAIL_FROM=InvestHepi <alerts@yourdomain.com>   # only if you verified your own domain
# ALERT_EMAIL=you@example.com                       # default recipient (can also be set in the app)
# APP_URL=https://your-app.vercel.app               # links in emails and the scheduler's self-call (Vercel's production URL by default)

# ---- Storage: added automatically by Vercel's Upstash Redis integration (either pair works) ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Scheduler (src/lib/timetable.ts, src/lib/scheduler.ts) ----
CRON_SECRET=         # long random string; Vercel Schedules sends it, GitHub's backup workflow too (repo secret)
# TICK_SECRET=       # a second secret that can only poke /api/cron/tick (give this one to cron-job.org)

# ---- Daily caps per user (protect the free AI quota) ----
# ASK_DAILY_LIMIT=60             # Ask AI questions
# REFRESH_DAILY_LIMIT=10         # the admin's refresh button (best model)
# USER_REFRESH_DAILY_LIMIT=5     # users' refresh button for My Interests (Flash-Lite)
# USER_REFRESH_GAP_MIN=90        # minutes between a user's presses
# AUTOGEN_DAILY_LIMIT=6          # background briefings: a new set's first one, catch-ups after an absence
# TRANSLATE_DAILY_LIMIT=80       # translations started by readers
# TRANSLATE_IP_DAILY_LIMIT=10    translations a signed-out visitor can start per address per day (TRANSLATE_DAILY_LIMIT stays the outer cap)
# PRICE_IP_PER_MIN=90            requests per address (IPv6: per /64) per minute to /api/quotes and /api/chart, counted in memory
# AI_USER_CEILING=0.7            share of a model's free daily allowance after which visitor-triggered AI work (catch-ups, refresh button, first briefings, Ask AI, guests' translation) pauses until its next day
# ALERT_TEST_DAILY_LIMIT=3       "Send test email" presses per person per day
# RULES_DAILY_LIMIT=30           # fresh rule-based copies (no AI)

# ---- Accounts (multi-user mode). Set all three to turn it on; otherwise the password mode below is used. ----
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
#   Authorized redirect URI: https://<your-app>.vercel.app/api/auth/callback/google
AUTH_SECRET=         # random string: `npx auth secret` or `openssl rand -base64 32`
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CONTACT_EMAIL=       # shown on /privacy and /terms (Google requires a privacy policy to publish sign-in)
OWNER_EMAIL=         # your Google email: you keep your existing data and get admin

# ---- Access control (single-user mode, used when the Auth vars above are empty) ----
APP_PASSWORD=        # the site asks for this once per browser (full access)
VIEWER_PASSWORD=     # optional guest password: read-only briefings, no holdings/alerts/Ask AI/refresh

# ---- Set by the platform or tests; don't set these yourself ----
# VERCEL, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, E2E_FAKE_AUTH

# Store directory override (tests set a fresh one per process). Default: /tmp/invest-helper on Vercel, .data locally.
STORE_DIR=
