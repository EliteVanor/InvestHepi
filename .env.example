# ---- AI providers (the app tries them in this order and falls back on failure) ----
# Claude: best analysis. Pay as you go. https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5       # or claude-sonnet-5-5 (about half the cost), claude-haiku-5-5 (cheapest)
# CLAUDE_EFFORT=medium               # low | medium | high

# Groq: free tier, fast. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini: free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Force one provider to the front: claude | groq | gemini | rules
# LLM_PROVIDER=

# ---- Optional extra news source: ticker-tagged company news (free tier) https://finnhub.io ----
FINNHUB_API_KEY=

# ---- Storage: added automatically by Vercel's Upstash Redis integration ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Access control ----
APP_PASSWORD=        # the site asks for this once per browser
CRON_SECRET=         # long random string; also add it as a GitHub repo secret
