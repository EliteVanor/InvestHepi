# ---- AI providers (the app tries them in this order and falls back on failure) ----
# Claude: best analysis. Pay as you go. https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5       # or claude-sonnet-5-5 (about half the cost), claude-haiku-5-5 (cheapest)
# CLAUDE_EFFORT=medium               # low | medium | high

# Groq: free tier, fast. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING=low                 # low | medium | high (more = better analysis, more tokens)
# LLM_MAX_TOKENS=4096                # output cap for free providers

# Google Gemini: free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Force one provider to the front: claude | groq | gemini | rules
# LLM_PROVIDER=

# ---- Optional: ticker-tagged company news + earnings dates (free tier) https://finnhub.io ----
FINNHUB_API_KEY=

# ---- Email alerts (optional). Set ONE of these. ----
# Resend: free tier, sends to your own address from onboarding@resend.dev without a domain. https://resend.com
RESEND_API_KEY=
# Or Gmail/any SMTP (app password): smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
# EMAIL_FROM=Invest Helper <alerts@yourdomain.com>   # only if you verified your own domain
# ALERT_EMAIL=you@example.com                       # default recipient (can also be set in the app)
# APP_URL=https://your-app.vercel.app               # link in emails (Vercel sets its own URL automatically)

# ---- Storage: added automatically by Vercel's Upstash Redis integration ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Access control ----
APP_PASSWORD=        # the site asks for this once per browser
CRON_SECRET=         # long random string; also add it as a GitHub repo secret
